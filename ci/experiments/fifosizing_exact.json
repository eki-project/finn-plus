{
    "global": {
      "bitfile_name": "bitfile/finn-accel.bit",
      "report_path": "report",

      "PAF": {
        "rails": [
          "0V85",
          "3V3"
        ],
        "sensors": []
      }
    },
    "experiments": [
      {
        "name": "experiment_fifosizing",
        "warmup": 1,
        "num_runs": 1,
        "functions": [
          {
            "function_name": "experiment_fifosizing",
            "kwargs": {"search_strategy": "binary_largest_first", "stop_condition": "both", "relaxation": 0.0, "relaxation_sweep": false}
          },
          {
            "function_name": "experiment_fifosizing",
            "kwargs": {"search_strategy": "bottom_up_exact", "stop_condition": "both", "relaxation": 0.0, "max_runtime_s": 3600}
          },
          {
            "function_name": "experiment_fifosizing",
            "kwargs": {"search_strategy": "top_down_bnb", "stop_condition": "both", "relaxation": 0.0, "seed_strategy": "binary_largest_first", "max_runtime_s": 3600}
          }
        ]
      }
    ]
  }
