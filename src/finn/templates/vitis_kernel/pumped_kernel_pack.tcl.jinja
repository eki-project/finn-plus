# Generated by FINN+ (finn.transformation.fpgadataflow.pumped_kernel): package the double-pumped
# stitched IP {{ inner }} as the Vitis kernel {{ module }}.
#
# FINN's Vitis kernels are DCP-based IP. The wrapper is synthesized out of context against the
# stitched IP's synthesis stub, the black box is filled by linking the stitched IP's checkpoint
# (read_checkpoint -cell does not accept it: Project 1-9), and the combined checkpoint replaces
# the source file groups of the packaged IP, as CreateStitchedIP does for unpumped kernels.

read_verilog -sv {{ wrapper_sv }}
read_verilog {{ inner_stub }}
synth_design -top {{ module }} -part {{ part }} -mode out_of_context
write_checkpoint -force {{ work_dir }}/{{ module }}_bb.dcp
close_design
read_checkpoint {{ work_dir }}/{{ module }}_bb.dcp
read_checkpoint {{ inner_dcp }}
link_design -top {{ module }} -part {{ part }} -mode out_of_context
if {[llength [get_cells -quiet -hierarchical -filter {NAME =~ finn/*}]] == 0} {
    error "FINN pumped kernel: the stitched IP checkpoint did not fill the black box finn"
}
write_checkpoint -force {{ work_dir }}/{{ module }}.dcp
close_design

create_project -force {{ module }}_pack {{ work_dir }}/pack_project -part {{ part }}
add_files -norecurse [list {{ wrapper_sv }} {{ inner_stub }}]
set_property top {{ module }} [current_fileset]
update_compile_order -fileset sources_1
ipx::package_project -root_dir {{ ip_dir }} -vendor {{ vendor }} -library {{ library }} \
    -taxonomy /UserIP -import_files -set_current true
set core [ipx::current_core]
# package_project infers only ap_clk as a clock; v++ connects ap_clk_2 to the platform's second
# kernel clock only if it is a clock interface
if {[ipx::get_bus_interfaces -quiet ap_clk_2 -of $core] eq ""} {
    ipx::infer_bus_interface ap_clk_2 xilinx.com:signal:clock_rtl:1.0 $core
}
foreach clk {ap_clk ap_clk_2} {
    if {[ipx::get_bus_interfaces -quiet $clk -of $core] eq ""} {
        error "FINN pumped kernel: no clock interface $clk"
    }
}
{%- for name in streams %}
ipx::associate_bus_interfaces -busif {{ name }} -clock ap_clk $core
{%- endfor %}
ipx::associate_bus_interfaces -clock ap_clk -reset ap_rst_n $core
set_property ipi_drc {ignore_freq_hz true} $core
set_property sdx_kernel true $core
set_property sdx_kernel_type rtl $core
set_property supported_families {} $core
set_property xpm_libraries {XPM_CDC XPM_MEMORY XPM_FIFO} $core
set_property auto_family_support_level level_2 $core
ipx::create_xgui_files $core
ipx::remove_all_file [ipx::get_file_groups xilinx_anylanguagebehavioralsimulation -of $core]
ipx::remove_all_file [ipx::get_file_groups xilinx_anylanguagesynthesis -of $core]
ipx::remove_file_group xilinx_anylanguagebehavioralsimulation $core
ipx::remove_file_group xilinx_anylanguagesynthesis $core
file delete -force {{ ip_dir }}/src {{ ip_dir }}/sim
file mkdir {{ ip_dir }}/dcp {{ ip_dir }}/impl
file copy -force {{ work_dir }}/{{ module }}.dcp {{ ip_dir }}/dcp
ipx::add_file_group xilinx_synthesischeckpoint $core
ipx::add_file dcp/{{ module }}.dcp [ipx::get_file_groups xilinx_synthesischeckpoint -of $core]
ipx::add_file_group xilinx_simulationcheckpoint $core
ipx::add_file dcp/{{ module }}.dcp [ipx::get_file_groups xilinx_simulationcheckpoint -of $core]
{%- if inner_xdc %}
# The stitched IP's constraints, written relative to its block design cell (kernel_xdc_export_tcl),
# which now sits below the wrapper's instance finn
file copy -force {{ inner_xdc }} {{ ip_dir }}/impl/{{ inner_xdc_name }}
ipx::add_file_group xilinx_implementation $core
ipx::add_file impl/{{ inner_xdc_name }} [ipx::get_file_groups xilinx_implementation -of $core]
set xdc [ipx::get_files impl/{{ inner_xdc_name }} -of_objects [ipx::get_file_groups xilinx_implementation -of $core]]
set_property used_in [list implementation] $xdc
set_property scoped_to_cells finn/{{ inner_bd_cell }} $xdc
{%- endif %}
ipx::update_checksums $core
ipx::check_integrity -kernel $core
ipx::save_core $core
