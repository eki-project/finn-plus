[connectivity]
{% for kernel, cu in nk -%}
nk={{ kernel }}:1:{{ cu }}
{% endfor %}
{% for origin_cu, target_cu in sc.items() -%}
sc={{ origin_cu }}:{{ target_cu }}
{% endfor %}
{% for cu, sp_type in sp.items() -%}
sp={{ cu }}:{{ sp_type }}
{% endfor %}
{% for cu, slr in slr.items() -%}
slr={{ cu }}:{{ slr }}
{% endfor %}
{% for a, b in connects -%}
connect={{ a }}:{{ b }}
{% endfor %}
{{ connectivity_extras }}

[vivado]
{{ vivado_extras }}
